[Unit]
Description=执行网页投来的串口急停 / 拒绝 (只有停的方向; 确认发送和解除急停只在车机上)

[Service]
# root: 要改 /run/ops-cart/serial-write.json (0600) 和写执行绪日志. 只认急停 / 拒绝、一分钟内的请求,
# 链接不跟, 读不懂的删掉; 处理完目录是空的, path 单元才不会再拉起它.
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pxe/mcp_serial.py requests
WorkingDirectory=/opt/pxe
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
