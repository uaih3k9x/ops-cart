#!/bin/bash
# /etc/NetworkManager/dispatcher.d/50-ops-cart-smb (#11, #95)
# smb.conf 是 bind interfaces only: LAN1 没地址时 smbd 不起 (smb.service.d/ops-cart-lan1.conf 跳过) 或没绑上.
# LAN1 一有地址就 (重) 启 smbd 绑上. 只管开了自启或正在跑的 smb; 没装 Samba / 没启用也没在跑时什么都不做.
[ "$1" = "eno1" ] || exit 0
case "$2" in
    up|dhcp4-change)
        { systemctl is-enabled -q smb.service || systemctl is-active -q smb.service; } && systemctl restart smb.service ;;
esac
exit 0
