# /etc/ops-cart/pxe.env —— 装机网段 (LAN1 / eno1). 部署时按现场改, 不进仓库.
# pxe-server / pxe-http-boot / pxe-http-repo 三个单元和 kiosk 生成的 grub 菜单都读这一份.
# 地址池不能包含 PXE_IP, 且要在 PXE_IP/PXE_PREFIX 网段内.
PXE_IP=192.0.2.1
PXE_PREFIX=24
PXE_POOL=192.0.2.10,192.0.2.20
# 网络里没有别的 DHCP 时推车自己发地址的限时 (分钟), 到点停发, 车机上可续期 (#11). 不写 = 30; 0 = 不限时
#PXE_SERVE_MINUTES=30
